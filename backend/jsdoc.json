{
  "source": {
    "include": ["apps", "libs"],
    "includePattern": ".+\\.ts$",
    "excludePattern": "(\\.spec\\.ts$|[\\\\/]test[\\\\/])",
    "exclude": ["node_modules", "dist", "docs"]
  },
  "plugins": ["./jsdoc-typescript.plugin.js"],
  "opts": {
    "destination": "./docs",
    "recurse": true,
    "readme": "./README.md"
  }
}
