NODE_ENV=development

# HTTP
HTTP_PORT=3002

# Microservice (TCP, interno)
HOST=0.0.0.0
MICROSERVICE_PORT=3003

# Database (PostgreSQL, compartida con los demás microservicios)
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USERNAME=tu_usuario
DATABASE_PASSWORD=tu_contraseña
DATABASE_NAME=agrotrace

# users-service (TCP), usado por ValidationService de @app/shared
USERS_SERVICE_HOST=localhost
USERS_SERVICE_PORT=3001

# Json Web Tokens (mismo secreto que users-service, para verificar los tokens)
JWT_SECRET=cambia-este-secreto

# CORS: URL(s) del frontend separadas por coma. Comentada = se acepta cualquier origen (desarrollo)
# CORS_ORIGIN=http://localhost:5173
