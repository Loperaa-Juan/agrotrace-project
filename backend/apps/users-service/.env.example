NODE_ENV=development

# Json Web Tokens (los demás microservicios deben usar este mismo secreto)
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=15m

# HTTP
HTTP_PORT=3000

# Microservice (TCP, interno)
HOST=0.0.0.0
MICROSERVICE_PORT=3001

# Database (PostgreSQL, compartida con los demás microservicios)
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USERNAME=tu_usuario
DATABASE_PASSWORD=tu_contraseña
DATABASE_NAME=agrotrace

# CORS: URL(s) del frontend separadas por coma. Comentada = se acepta cualquier origen (desarrollo)
# CORS_ORIGIN=http://localhost:5173
